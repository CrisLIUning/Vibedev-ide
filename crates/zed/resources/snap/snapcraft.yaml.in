# VIBEDEV: snap `name`/`parts`/`source` (build identity + download) left as the
# upstream recipe — rework them only if/when VibeDev actually publishes a Snap.
# Below: the software-center-facing metadata, rebranded off zed.dev.
name: zed
title: VibeDev
base: core24
version: "$RELEASE_VERSION"
summary: A modern AI-assisted code editor
description: |
  VibeDev is a modern code editor built on a GPU-accelerated Rust core, with a
  built-in AI agent and self-hosted real-time collaboration.
grade: stable
confinement: classic
compression: lzo
website: https://aitoken.bigopen.cn
source-code: https://github.com/CrisLIUning/Vibedev-ide
issues: https://github.com/CrisLIUning/Vibedev-ide/issues
contact: https://github.com/CrisLIUning/Vibedev-ide/issues

parts:
  zed:
    plugin: dump
    source: "https://github.com/zed-industries/zed/releases/download/v$RELEASE_VERSION/zed-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zed:
    command: usr/bin/zed
    common-id: dev.zed.Zed
    environment:
      ZED_BUNDLE_TYPE: snap
